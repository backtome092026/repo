# Back2Me runtime and build environment. Copy to .env.cloudflare and never commit it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="Back2Me <hello@your-verified-domain.com>"

# Deployment credentials are intentionally NOT stored here because --secrets-file
# uploads every entry to the Worker. Set these in your shell or GitHub Secrets:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
